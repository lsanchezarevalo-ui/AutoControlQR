# Copia este archivo a .env.production y completa los valores reales.
# No compartas ni subas a control de versiones el archivo .env.production.

# Subdominio público que apuntará al servidor (registro DNS tipo A).
DOMAIN=app.tudominio.com

# Contraseña de PostgreSQL. Genera una clave larga y única, por ejemplo:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Clave de firma de JWT. Genera una cadena aleatoria larga, por ejemplo:
#   openssl rand -hex 64
JWT_KEY=
